# Copy to .env.local (ignored) or export these values in the parent shell.
# Never commit a real key. The OpenRouter key is passed only at container start.
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui@sha256:6bb1fbe8ab0a3e0456067f493044ffb66a30a65a34be47f6a5862176a370dd16
OPEN_TERMINAL_IMAGE=ghcr.io/open-webui/open-terminal@sha256:5f48c86bb249dbbd9c18fca92cd4188a53787c50ac6ad0d8412b2b18f7071c61
OPENWEBUI_PORT=3001
OPENWEBUI_VOLUME_NAME=open-webui-data
OPEN_TERMINAL_VOLUME_NAME=open-terminal-data
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_BASE_URLS=https://openrouter.ai/api/v1
OPENAI_API_KEYS=
# Generated automatically by scripts/setup-openwebui.sh when absent.
WEBUI_SECRET_KEY=
OPEN_TERMINAL_API_KEY=
# Read-only mount. Override if the durable Codex runbooks move.
CODEX_RUNBOOKS_DIR=/Users/rajeev/.codex/docs
